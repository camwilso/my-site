---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  author?: string;
  published?: Date;
  modified?: Date;
}

const {
  title = 'cam wilson',
  description = 'cam wilson | new york, ny 2024',
  image,
  author,
  published,
  modified,
} = Astro.props;

const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Cam Wilson"
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {author && <meta name="author" content={author} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4YLQWPPQVR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-4YLQWPPQVR');
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
