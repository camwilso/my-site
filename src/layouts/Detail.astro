---
import Base from './Base.astro';
import BackLink from '../components/BackLink.astro';

interface Props {
  title: string;
  description?: string;
  logo?: string;
  logoAlt?: string;
}

const { title, description, logo, logoAlt } = Astro.props;
---

<Base title={`${title} — Cam Wilson`} description={description}>
  <BackLink />
  <h1>{title}</h1>
  {logo && <img class="page-logo" src={logo} alt={logoAlt ?? ''} />}
  <slot />
</Base>
