---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  image?: string;
}

const { title, description, date, image } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${title} — Cam Wilson`} description={description}>
  <article>
    <a href="/blog" class="back">← Blog</a>
    <h1 class="post-title">{title}</h1>
    <p class="muted">{formatted}</p>
    {image && <img src={image} alt="" />}
    <slot />
  </article>
</Base>

<style>
  .post-title {
    font-size: 2rem;
  }
</style>
