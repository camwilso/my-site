---
interface Props {
  href?: string;
  label?: string;
}

const { href = '/', label = 'Back to home' } = Astro.props;
---

<a href={href} class="back" aria-label={label}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M19 12H5"></path>
    <path d="m12 19-7-7 7-7"></path>
  </svg>
</a>
