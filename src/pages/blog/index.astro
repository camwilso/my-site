---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base title="Blog — Cam Wilson" description="Articles by Cam Wilson">
  <h1>Blog</h1>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          <span class="muted">{fmt(post.data.date)}</span>
          <p class="muted">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .posts li {
    margin-bottom: 2rem;
  }

  .posts li a {
    font-weight: 600;
    margin-right: 0.75rem;
  }

  .posts li p {
    margin: 0.25rem 0 0;
  }
</style>
