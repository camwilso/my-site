---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const domains = await getCollection('domains');
  return domains.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const [name, tld] = (() => {
  const i = entry.data.domain.lastIndexOf('.');
  return [entry.data.domain.slice(0, i), entry.data.domain.slice(i)];
})();
---

<Base
  title={`${entry.data.domain} — Cam Wilson`}
  description={`${entry.data.domain} is currently held by ${entry.data.heldBy}.`}
>
  <div class="domain-page">
    <h1>{name}<span class="tld">{tld}</span></h1>
    <p>Currently held by <a href="/">{entry.data.heldBy}</a>.</p>
    <Content />
    <div class="icon-row">
      <a href="mailto:hello@cam-wilson.com" aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/camjwilsonn" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"></path>
        </svg>
      </a>
      <a href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 10 9-7 9 7"></path>
          <path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"></path>
        </svg>
      </a>
    </div>
  </div>
</Base>

<style>
  .domain-page {
    min-height: calc(100vh - 8rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .domain-page h1 {
    margin-bottom: 0.75rem;
  }

  .tld {
    color: #b8d8e8;
  }

  .icon-row {
    display: flex;
    gap: 1.5rem;
    margin-top: 4rem;
  }

  .icon-row a {
    text-decoration: none;
    width: 3.5rem;
    height: 3.5rem;
    border: 3px solid var(--text);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .icon-row a:hover {
    color: var(--muted);
    border-color: var(--muted);
    transform: translateY(-2px);
  }

  .icon-row svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
